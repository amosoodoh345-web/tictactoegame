# Copy this file to .env and fill in your own Neon connection string.
# Get it from the Neon dashboard: Project -> Connection Details -> "Pooled connection".
# It looks like: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require

# Port the Node server listens on (optional, defaults to 3000).
PORT=3000
